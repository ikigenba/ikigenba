#!/bin/bash
# Managed by Terraform — the metaspot "create a server" standard (AGENTS.md).
# Runs once at first boot via cloud-init. This is the launch-time baseline;
# existing boxes are updated out-of-band (cloud-init does not re-run on reboot),
# same discipline as the AMI pin. Non-secret identity/topology only.
set -euo pipefail

# --- /etc/metaspot/env -------------------------------------------------------
install -d -m 0755 /etc/metaspot
cat > /etc/metaspot/env <<'METASPOT_ENV_FILE'
METASPOT_ENV=${env}
METASPOT_NODE=${node}
METASPOT_FQDN=${fqdn}
METASPOT_DOMAIN=${domain}
METASPOT_DNS_ZONE=${dns_zone}
METASPOT_AWS_ACCOUNT_ID=${aws_account_id}
METASPOT_AWS_REGION=${aws_region}
METASPOT_BACKUP_BUCKET=${backup_bucket}
METASPOT_ENV_FILE
chmod 0644 /etc/metaspot/env

# --- /usr/local/bin/metaspot-launch -----------------------------------------
# Platform launcher; source lives in templates/metaspot-launch in the repo.
cat > /usr/local/bin/metaspot-launch <<'METASPOT_LAUNCHER_EOF'
${launcher_source}
METASPOT_LAUNCHER_EOF
chown root:root /usr/local/bin/metaspot-launch
chmod 0755 /usr/local/bin/metaspot-launch

# --- Launcher runtime dependencies ------------------------------------------
# AL2023 ships neither AWS CLI nor jq by default; the launcher needs both.
# Package names on AL2023 are awscli-2 and jq (NOT aws-cli — that doesn't exist).
dnf install -y -q awscli-2 jq
