{{define "head"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <base href="{{.Base}}">
  <title>{{.Service}} · wiki</title>
  <link rel="stylesheet" href="{{.Mount}}static/tokens.css">
  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --read-font-body: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --read-font-mono: ui-monospace, "SFMono-Regular", "Cascadia Code", "Liberation Mono", Menlo, Consolas, monospace;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--color-text);
      background: var(--color-bg);
      font-family: var(--font-body, var(--read-font-body));
      font-size: var(--text-body-size);
      line-height: var(--text-body-lh);
	  display: flex;
	  flex-direction: column;
    }

	header,
    main,
    footer {
	  width: 100%;
	  max-width: var(--layout-max-width);
	  margin: 0 auto;
	  padding-left: var(--layout-gutter);
	  padding-right: var(--layout-gutter);
	}

	header {
	  min-height: var(--space-16);
	  display: flex;
	  align-items: center;
	  gap: var(--space-6);
	  border-bottom: var(--border-width) solid var(--color-border);
    }

    main {
	  flex: 1;
	  padding-top: var(--space-12);
	  padding-bottom: var(--space-16);
      display: grid;
	  align-content: start;
      gap: var(--space-8);
    }

    .busy main {
      opacity: 0.45;
    }

    .busy::after {
      content: "";
      position: fixed;
      top: 50%;
      left: 50%;
      width: 40px;
      height: 40px;
      margin: -20px 0 0 -20px;
      border: 4px solid var(--color-border);
      border-top-color: var(--color-accent);
      border-radius: 50%;
      animation: busy-spin 0.8s linear infinite;
    }

    @keyframes busy-spin {
      to {
        transform: rotate(360deg);
      }
    }

    .home {
      font-family: var(--font-mono, var(--read-font-mono));
      font-size: var(--text-label-size);
      line-height: var(--text-label-lh);
      font-weight: var(--text-label-weight);
      text-transform: uppercase;
      color: var(--color-text-muted);
      text-decoration: none;
    }

    .home:hover,
    .home:focus-visible {
      color: var(--color-text);
    }

    .brand {
      flex: none;
    }

    .brand img {
      display: block;
      width: auto;
      height: var(--space-8);
    }

    h1 {
      margin: 0;
      font-family: var(--font-display, var(--read-font-body));
      font-size: clamp(40px, 8vw, var(--text-display-size));
      line-height: var(--text-display-lh);
      font-weight: var(--text-display-weight);
      letter-spacing: 0;
    }

    h2 {
      margin: 0;
      font-family: var(--font-display, var(--read-font-body));
      font-size: var(--text-h2-size);
      line-height: var(--text-h2-lh);
      font-weight: var(--text-h2-weight);
      letter-spacing: 0;
    }

    article {
      max-width: 680px;
      display: grid;
      gap: var(--space-4);
    }

    article[aria-label="Subject page"] {
      max-width: none;
    }

    p {
      margin: 0;
      white-space: pre-wrap;
    }

    .prose {
      display: grid;
      gap: var(--space-4);
      color: var(--color-text);
    }

    .prose h1,
    .prose h2,
    .prose h3,
    .prose h4,
    .prose h5,
    .prose h6 {
      margin: var(--space-6) 0 0;
      font-family: var(--font-display, var(--read-font-body));
      line-height: var(--text-h2-lh);
      letter-spacing: 0;
    }

    .prose p {
      margin: 0;
      white-space: normal;
    }

    .prose ul,
    .prose ol {
      margin: 0;
      padding: 0 0 0 var(--space-6);
      display: grid;
      gap: var(--space-2);
      list-style: revert;
    }

    .prose li {
      padding-left: var(--space-1);
    }

    .prose code {
      padding: 0 var(--space-1);
      font-family: var(--font-mono, var(--read-font-mono));
      background: var(--color-surface);
      border: var(--border-width) solid var(--color-border);
    }

    .prose pre {
      margin: 0;
      padding: var(--space-4);
      overflow-x: auto;
      background: var(--color-surface);
      border: var(--border-width) solid var(--color-border);
    }

    .prose pre code {
      padding: 0;
      border: 0;
      background: transparent;
    }

    .prose blockquote {
      margin: 0;
      padding: 0 0 0 var(--space-4);
      color: var(--color-text-muted);
      border-left: var(--border-width) solid var(--color-border);
    }

    .prose table {
      width: 100%;
      border-collapse: collapse;
    }

    .prose th,
    .prose td {
      padding: var(--space-2);
      border: var(--border-width) solid var(--color-border);
      text-align: left;
    }

    form {
      display: flex;
      max-width: 680px;
	  gap: var(--space-3);
    }

    input,
    select,
    button {
	  border: var(--border-width) solid var(--color-border-strong);
	  border-radius: var(--radius);
      font: inherit;
    }

    input,
    select {
      min-width: 0;
      flex: 1;
      padding: 0 var(--space-4);
      color: var(--color-text);
	  background: var(--color-bg);
    }

	main input,
	main button {
	  min-height: var(--control-h-lg);
	}

    main > form[role="search"] {
      width: 100%;
      margin-inline: auto;
    }

    button {
      padding: 0 var(--space-6);
      color: var(--color-bg);
      background: var(--color-accent);
	  cursor: pointer;
    }

	.scope-selector {
	  max-width: none;
	  margin-left: auto;
	  align-items: center;
	  font-family: var(--font-mono, var(--read-font-mono));
	  font-size: var(--text-label-size);
	  line-height: var(--text-label-lh);
	  font-weight: var(--text-label-weight);
	  text-transform: uppercase;
	}

	.scope-selector select,
	.scope-selector button {
	  min-height: var(--control-h-sm);
	}

	.scope-selector select {
	  flex: none;
	  padding: 0 var(--space-3);
	}

    .header-question {
      width: 360px;
      max-width: 100%;
      margin-inline: 0;
    }

    .header-question input,
    .header-question button {
      min-height: var(--control-h-sm);
    }

    .header-question input {
      width: 100%;
    }

	.suggested h2 {
	  font-family: var(--font-mono, var(--read-font-mono));
	  font-size: var(--text-label-size);
	  line-height: var(--text-label-lh);
	  font-weight: var(--text-label-weight);
	  text-transform: uppercase;
	}

	.suggested li {
	  display: flex;
	  justify-content: space-between;
	  gap: var(--space-4);
	  padding: var(--space-3) 0;
	  border-bottom: var(--border-width) solid var(--color-border);
	}

	.subject-type {
	  font-family: var(--font-mono, var(--read-font-mono));
	  font-size: var(--text-label-size);
	  text-transform: uppercase;
	  color: var(--color-text-muted);
	}

    nav {
      max-width: 680px;
      border-top: var(--border-width) solid var(--color-border);
    }

    .links {
      margin-top: var(--space-8);
      padding-top: var(--space-6);
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-top: var(--border-width) solid var(--color-border);
    }

    .links nav {
      max-width: none;
      border-top: 0;
    }

    .links nav + nav {
      padding-left: var(--space-6);
      border-left: var(--border-width) solid var(--color-border);
    }

    .links h2 {
      font-family: var(--font-mono, var(--read-font-mono));
      font-size: var(--text-label-size);
      line-height: var(--text-label-lh);
      font-weight: 700;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }

    .links ul {
      font-size: var(--text-small-size);
      color: var(--color-text-muted);
    }

    .links a {
      color: var(--color-text-muted);
    }

    .links a:hover,
    .links a:focus-visible {
      color: var(--color-text);
    }

    @media (max-width: 640px) {
      header {
        flex-wrap: wrap;
        padding-top: var(--space-3);
        padding-bottom: var(--space-3);
      }

      .header-question {
        width: 100%;
      }

      .links {
        grid-template-columns: 1fr;
      }

      .links nav + nav {
        margin-top: var(--space-6);
        padding-top: var(--space-6);
        padding-left: 0;
        border-top: var(--border-width) solid var(--color-border);
        border-left: 0;
      }
    }

    ul {
      margin: 0;
      padding: var(--space-4) 0 0;
      display: grid;
      gap: var(--space-3);
      list-style: none;
    }

    a {
      color: var(--color-text);
      text-decoration-thickness: var(--border-width);
      text-underline-offset: 0.2em;
    }

    footer {
	  padding-top: var(--space-4);
	  padding-bottom: var(--space-6);
	  border-top: var(--border-width) solid var(--color-border);
      font-family: var(--font-mono, var(--read-font-mono));
      font-size: var(--text-label-size);
      line-height: var(--text-label-lh);
      font-weight: var(--text-label-weight);
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
  </style>
</head>
<body>
	<header>
	  <a class="brand" href="/"><img src="static/logo.png" alt="ikigenba"></a>
	  <a class="home" href="{{.Mount}}">Home</a>
	  <form class="scope-selector" action="select" method="get" aria-label="Select scope">
		<label for="scope-selector">Scope</label>
		<select id="scope-selector" name="to">
		  {{range .Scopes}}<option value="{{.Name}}"{{if eq .Name $.Scope}} selected{{end}}>{{.Name}}</option>{{end}}
		</select>
		<noscript><button type="submit">Go</button></noscript>
	  </form>
	  <form class="header-question" action="." method="get" role="search" data-busy>
		{{if eq .Tier "private"}}
		<input type="text" name="q" aria-label="Ask this wiki" value="{{.Query}}">
		<button type="submit" data-busy-label="Asking…">Ask</button>
		{{else}}
		<input type="text" name="q" aria-label="Search this wiki" value="{{.Query}}">
		<button type="submit" data-busy-label="Searching…">Search</button>
		{{end}}
	  </form>
	</header>
  <main>
{{end}}

{{define "foot"}}  </main>
  <footer>{{.Service}} {{.Version}}</footer>
  <script type="text/javascript">
	document.querySelector(".scope-selector select").addEventListener("change", function () {
	  this.form.submit();
	});
    document.querySelectorAll("form[data-busy]").forEach(function (form) {
      form.addEventListener("submit", function () {
        var button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        button.textContent = button.dataset.busyLabel;
        document.body.classList.add("busy");
      });
    });
  </script>
</body>
</html>{{end}}
