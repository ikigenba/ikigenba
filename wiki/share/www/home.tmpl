{{define "home"}}{{template "head" .}}
<h1>{{.Service}}</h1>
<form action="" method="get" role="search" data-busy>
  {{if eq .Tier "private"}}
  <input type="text" name="q" aria-label="Ask this wiki" value="{{.Query}}">
  <button type="submit" data-busy-label="Asking…">Ask</button>
  {{else}}
  <input type="text" name="q" aria-label="Search this wiki" value="{{.Query}}">
  <button type="submit" data-busy-label="Searching…">Search</button>
  {{end}}
</form>
{{if .Asked}}
<article aria-label="Answer">
  <h2>{{.Query}}</h2>
  <div class="prose">{{.AnswerHTML}}</div>
  {{if .Cites}}
  <nav aria-label="Cited pages">
    <ul>
      {{range .Cites}}<li><a href="{{.Href}}">{{.Name}}</a></li>{{end}}
    </ul>
  </nav>
  {{end}}
  {{if .Mentions}}
  <nav aria-label="Mentioned subjects">
    <ul>
      {{range .Mentions}}<li><a href="{{.Href}}">{{.Name}}</a></li>{{end}}
    </ul>
  </nav>
  {{end}}
</article>
{{else}}
{{if .Searched}}
{{if .Results}}
<nav aria-label="Search results">
  <ul>
    {{range .Results}}<li><a href="{{.Href}}">{{.Name}}</a></li>{{end}}
  </ul>
</nav>
{{else}}
<p>No matches.</p>
{{end}}
{{else}}
{{if .Recent}}
<section class="suggested" aria-labelledby="suggested-pages">
  <h2 id="suggested-pages">Suggested pages</h2>
  <ul>
    {{range .Recent}}<li><a href="{{.Href}}">{{.Name}}</a><span class="subject-type">{{.Type}}</span></li>{{end}}
  </ul>
</section>
{{end}}
{{end}}
{{end}}
{{template "foot" .}}{{end}}
