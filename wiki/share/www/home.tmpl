{{define "home"}}{{template "head" .}}
<h1>{{.Service}}</h1>
{{if .Asked}}
<article aria-label="Answer">
  <h2>{{.Query}}</h2>
  <div class="prose">{{.AnswerHTML}}</div>
  {{if or .Cites .Mentions}}<div class="links">
    {{if .Cites}}
    <nav aria-label="Cited pages">
      <h2>Cited pages</h2>
      <ul>
        {{range .Cites}}<li><a href="{{.Href}}">{{.Name}}</a></li>{{end}}
      </ul>
    </nav>
    {{end}}
    {{if .Mentions}}
    <nav aria-label="Mentions">
      <h2>Mentions</h2>
      <ul>
        {{range .Mentions}}<li><a href="{{.Href}}">{{.Name}}</a></li>{{end}}
      </ul>
    </nav>
    {{end}}
  </div>{{end}}
</article>
{{else}}
{{if .Recent}}
<section class="suggested" aria-labelledby="suggested-pages">
  <h2 id="suggested-pages">Suggested pages</h2>
  <ul>
    {{range .Recent}}<li><a href="{{.Href}}">{{.Name}}</a><span class="subject-type">{{.Type}}</span></li>{{end}}
  </ul>
</section>
{{end}}
{{end}}
{{template "foot" .}}{{end}}
