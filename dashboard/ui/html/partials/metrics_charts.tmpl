  <div class="metrics-chart-slot">{{.SystemDisk}}</div>
  <div class="metrics-chart-slot">{{.ServiceMemory}}</div>
  <div class="metrics-chart-slot">{{.ServiceDisk}}</div>
</div>
{{end}}
