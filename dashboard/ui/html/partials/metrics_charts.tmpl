{{define "metrics_charts"}}
<div class="metrics-charts" aria-label="Metrics charts">
  <div class="metrics-chart-slot metrics-panel">{{.SystemMemory}}</div>
  <div class="metrics-chart-slot metrics-panel">{{.SystemDisk}}</div>
  <div class="metrics-chart-slot metrics-panel">{{.ServiceMemory}}</div>
  <div class="metrics-chart-slot metrics-panel">{{.ServiceDisk}}</div>
</div>
{{end}}
