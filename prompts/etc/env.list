# Format: `secret NAME` = customer data resolved from the keyring and pushed to SSM;
#         `config NAME value` = non-secret local-dev config, not pushed.
secret ANTHROPIC_API_KEY
secret OPENAI_API_KEY
secret GEMINI_API_KEY
secret ZAI_API_KEY
secret OPENROUTER_API_KEY
config PROMPTS_OPENAI_AUTH_PATH $HOME/.secrets/openai-auth.json
