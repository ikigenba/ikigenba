// go.work — local-dev workspace for the on-box suite's Go modules. Lets the
// service modules resolve the shared `eventplane` library from its sibling
// source tree without a network fetch. Production builds do NOT rely on this
// file: each consumer also carries a committed `replace eventplane =>
// ../eventplane` in its go.mod, so `bin/build` is deterministic with or without
// the workspace.
go 1.26

use (
	.
	./appkit
	./artifacts
	./bin/bintest
	./crm
	./cron
	./dashboard
	./dropbox
	./eventplane
	./github
	./gmail
	./ledger
	./notify
	./opsctl
	./prompts
	./registry
	./repos
	./scripts
	./sites
	./telemetry
	./webhooks
	./wiki
)

// No replace directives here — a workspace replace silently overrides every
// module's committed pin, so dev compiles code prod never sees (root
// project/design/D22.md). To hack on a local agentkit checkout, add a replace
// TEMPORARILY with `go work edit -replace github.com/ikigenba/agentkit=<path>`
// and drop it (`go work edit -dropreplace ...`) before committing.
