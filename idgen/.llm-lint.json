{
  "model": { "provider": "openrouter", "model": "deepseek-v4-flash" },
  "rules": ["lint-rules"],
  "enable": [
    "boolean-state-machine",
    "no-sleep-in-tests",
    "asymmetric-mode-dispatch",
    "call-count-scripted-fake",
    "closure-captured-error-flag",
    "dead-flag-metadata",
    "derived-constant-without-provenance",
    "discarded-output-write-error",
    "double-reported-error-diagnostic",
    "duplicated-validation-across-layers",
    "error-context-restated-by-caller",
    "expected-value-from-code-under-test",
    "exported-mutable-package-var",
    "god-entrypoint",
    "helper-asserts-and-returns",
    "implementation-derived-test-domain",
    "ineffective-env-mutation-in-test",
    "io-error-mapped-to-data-error"
  ]
}
