{
  "model": { "provider": "openrouter", "model": "gpt-5.6-luna" },
  "rules": ["lint-rules"],
  "enable": [
    "boolean-state-machine",
    "no-sleep-in-tests",
    "asymmetric-mode-dispatch",
    "call-count-scripted-fake",
    "closure-captured-error-flag",
    "dead-flag-metadata",
    "derived-constant-without-provenance",
    "discarded-output-write-error",
    "double-reported-error-diagnostic",
    "duplicated-validation-across-layers"
  ]
}
