{
  "_comment": "Inline policy for the per-space instance role ikigenba-space-<name>. The operator-side tool substitutes three literal placeholders at create time; Terraform never reads this file. <name> is the space name (its SSM path /ikigenba/<name>/* and its bucket prefix <name>/). <domain> is the space's domain, by default <name>.<account domain> where the account domain is the `domain` property at /ikigenba/account; the space's records are <domain> and *.<domain>. <zone_id> is the hosted zone found by longest-suffix match of <domain> over the account's hosted zones. The role also carries the ikigenba-space-boundary permissions boundary, which is the ceiling: nothing granted here can exceed it.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:DeleteParameters"
      ],
      "Resource": "arn:aws:ssm:us-east-2:602773793009:parameter/ikigenba/<name>/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.us-east-2.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::sbx-ikigenba-dev-602773793009/<name>/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::sbx-ikigenba-dev-602773793009",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "<name>/",
            "<name>/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/<zone_id>",
      "Condition": {
        "ForAllValues:StringLike": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "<domain>",
            "*.<domain>"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "route53:ListResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/<zone_id>"
    },
    {
      "Effect": "Allow",
      "Action": "route53:GetChange",
      "Resource": "arn:aws:route53:::change/*"
    }
  ]
}
