**/.terraform/*
# Bootstrap state is local and committed: it is the only record that
# terraform owns the state bucket. Everything else is in S3. The .backup
# snapshots churn on every apply and are not committed.
*.tfstate.backup
!bootstrap/terraform.tfstate
crash.log
crash.*.log
# terraform.tfvars.json is the one committed var file: the single statement
# of the root domain and region, read by Terraform and by devctl.
*.tfvars
*.tfvars.json
!terraform.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
